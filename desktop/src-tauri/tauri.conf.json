{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyfold",
  "version": "0.3.0",
  "identifier": "com.diego.keyfold",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Local key vault for coding agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 432 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQjU1Q0ExOTdCMDQ1MTIKUldRU1JiQ1hvVnkxTUVjNHVMUlhHdW15c2Zsc2J1b0ZMWEd6VEtyWWUvN05KazVmMVdkYkRwVWkK",
      "endpoints": ["https://github.com/diegoperezg7/keyfold/releases/latest/download/latest.json"]
    }
  }
}
